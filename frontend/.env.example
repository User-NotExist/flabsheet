# Copy to .env and adjust. Every value here is optional; the defaults are shown.
# These are read by the Next.js server only (no NEXT_PUBLIC_* variables), so
# none of them reach the browser.

# Where the Next.js server reaches the backend (/api/* route handler and
# src/proxy.ts). Under Docker Compose this is overridden with
# http://backend:8000 by compose.dev.yaml / compose.prod.yaml.
BACKEND_URL=http://localhost:8000

# Name of the session cookie. Must match the backend's SESSION_COOKIE_NAME.
SESSION_COOKIE_NAME=flabsheet_session
