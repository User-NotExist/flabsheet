# Copy to .env and replace every "change-me" value.
# Generate secrets with: openssl rand -hex 24

# Address Redis and RustFS listen on. Keep 127.0.0.1 when the judge runs on the
# same machine (dev). In production, use the app server's private IP so judge
# hosts can reach them, and firewall everything else.
BIND_ADDR=127.0.0.1

# PostgreSQL (always bound to 127.0.0.1)
POSTGRES_DB=flabsheet
POSTGRES_USER=flabsheet
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Redis (shared with the judge worker: same value goes in its redis.password file)
REDIS_PASSWORD=change-me
REDIS_PORT=6379

# RustFS root credentials (used by the API and storage-init).
# Do not use the default "rustfsadmin".
RUSTFS_ACCESS_KEY=change-me
RUSTFS_SECRET_KEY=change-me-at-least-8-chars
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# --- App containers (compose.dev.yaml / compose.prod.yaml) ---
# App settings (FRONTEND_URL, BACKEND_URL, ...) go in backend/.env and frontend/.env
BACKEND_PORT=8000
FRONTEND_PORT=3000
# Prod only: where backend/frontend ports listen (keep 127.0.0.1 behind a reverse proxy)
APP_BIND_ADDR=127.0.0.1
IMAGE_TAG=latest
# Subnet of the stack's Docker network; the backend trusts X-Forwarded-For from
# it. Only set this if the default (dev 172.30.10.0/24, prod 172.30.20.0/24)
# collides with another network on the host.
# STACK_SUBNET=172.30.10.0/24
