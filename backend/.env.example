# Copy to .env and replace every "change-me" value.
# Loaded by config.py (pydantic-settings); real environment variables override
# this file.

# --- Required ---
# Use the credentials and ports from the root .env. Under Docker Compose both
# URLs are overridden to point at the postgres / redis services, so the values
# here only matter when the backend runs directly on the host.
POSTGRES_URL=postgresql+psycopg://flabsheet:change-me@localhost:5432/flabsheet
REDIS_URL=redis://:change-me@localhost:6379/0

# --- Optional (defaults shown) ---
# Public URL of the frontend. An https:// URL also makes the session cookie
# Secure unless SESSION_COOKIE_SECURE is set.
FRONTEND_URL=http://localhost:3000

# Log every SQL statement
DATABASE_ECHO=false

# --- Sessions / auth ---
# Must match the frontend's SESSION_COOKIE_NAME
SESSION_COOKIE_NAME=flabsheet_session
SESSION_TTL_DAYS=7
# Leave unset to derive from FRONTEND_URL (Secure only when served over https)
# SESSION_COOKIE_SECURE=true

# Failed logins allowed per login id, and separately per client IP, inside the
# window before 429. Everyone behind one IP (a lab, a campus NAT) shares the
# per-IP count, so raise this if a whole room gets locked out.
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# --- Object storage (RustFS, S3 API) ---
# Use RUSTFS_ACCESS_KEY / RUSTFS_SECRET_KEY and RUSTFS_PORT from the root .env.
# Under Docker Compose the endpoint and both keys are overridden, so the values
# here only matter when the backend runs directly on the host.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-at-least-8-chars
S3_REGION=us-east-1
S3_BUCKET_ASSETS=assets
S3_BUCKET_PROBLEMS=problems
# Address the judge host uses to reach RustFS. Presigned URLs in build jobs are
# signed for this host, so set it whenever the judge cannot resolve
# S3_ENDPOINT_URL (under Compose that is http://rustfs:9000). Leave unset to
# reuse S3_ENDPOINT_URL.
# S3_PUBLIC_ENDPOINT_URL=http://10.0.0.5:9000

# --- Judge ---
# Bearer token the judge worker sends to /internal/judge-events and
# /internal/judge-jobs (the worker's api token file holds the same value).
# While empty, every /internal request is refused and builds never finish.
# compose.dev.yaml overrides this with JUDGE_API_TOKEN from the root .env.
JUDGE_API_TOKEN=change-me
